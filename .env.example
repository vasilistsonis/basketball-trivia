# Optional public question-bank configuration. Leave blank for the bundled offline bank.
# Vite embeds these two PUBLIC values into the app at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only the local database seeding tools use the following credentials.
# Never prefix a service-role key with VITE_; it must not ship with the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-seeding-only
